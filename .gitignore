# Byte compiled
__pycache__/
*.py[cod]
*.pyo

# Virtual environments
.venv/
env/
venv/

# OS files
.DS_Store

# Pytest cache
.pytest_cache/

# Environment variables — never commit API keys
.env

# Logs — runtime output is not committed, but the example agent traces
# referenced from ai_interactions.md are.
logs/*
!logs/traces/
logs/traces/*
!logs/traces/example-*.md
